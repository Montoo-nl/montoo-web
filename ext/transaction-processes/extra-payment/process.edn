;; Extra payment
;;
;; A technician who has already been paid for a job can ask the company for an
;; extra amount - unforeseen work, extra materials, a longer day than quoted.
;;
;; Each request is its own transaction on the same listing. The transaction it
;; belongs to is written to protectedData as `parentTxId`, so both the app and
;; the notification emails can link back to the original job.
;;
;; The flow mirrors the main payment flow: the provider names the amount, the
;; customer pays it from a modal on the transaction page.
{:format :v3,
 :transitions
 [;; The technician asks for the extra amount. Privileged, because the amount
  ;; comes from the request rather than from the listing's price.
  {:name :transition/request-extra-payment,
   :to :state/payment-requested,
   :actor :actor.role/provider,
   :actions
   [{:name :action/privileged-set-line-items}
    {:name :action/update-protected-data}],
   :privileged? true}

  ;; The customer opens the payment modal: this creates the payment intent that
  ;; the browser then confirms with Stripe.
  ;; The line items are rewritten here rather than when the request was made,
  ;; because what Stripe charges depends on how the company pays and that is
  ;; only known now. Privileged, so the fee is worked out on the server.
  ;;
  ;; Order matters: privileged-set-line-items must run before the intent is
  ;; created. Sharetribe does not update a PaymentIntent's payin and payout if
  ;; the line items change after it exists.
  {:name :transition/initiate-payment,
   :from :state/payment-requested,
   :to :state/pending-confirmation,
   :actor :actor.role/customer,
   :actions
   [{:name :action/privileged-set-line-items}
    {:name :action/stripe-create-payment-intent}],
   :privileged? true}

  ;; Card confirmed. The money is captured and paid out to the technician in one
  ;; go - there is nothing left to deliver, the work is already done.
  {:name :transition/confirm-payment,
   :from :state/pending-confirmation,
   :to :state/paid,
   :actor :actor.role/customer,
   :actions
   [{:name :action/stripe-confirm-payment-intent}
    {:name :action/stripe-capture-payment-intent}
    {:name :action/stripe-create-payout}]}

  ;; The push counterpart of initiate-payment, for iDEAL. The PaymentIntent has
  ;; to be created with the allowed payment method types, which arrive as the
  ;; mandatory `paymentMethodTypes` transition parameter. The choice is written
  ;; to protectedData too, so a customer who comes back without having paid is
  ;; offered the same method again - a push intent cannot be confirmed as a card
  ;; one, or the other way round.
  {:name :transition/initiate-push-payment,
   :from :state/payment-requested,
   :to :state/pending-confirmation,
   :actor :actor.role/customer,
   :actions
   [{:name :action/privileged-set-line-items}
    {:name :action/update-protected-data}
    {:name :action/stripe-create-payment-intent-push}],
   :privileged? true}

  ;; Made by the operator from the Stripe webhook: the customer confirms in
  ;; their own bank and the browser never comes back through the client. The
  ;; payout has to be created here - :state/paid is final, so there is no later
  ;; transition that could ever pay the technician.
  ;; stripe-capture-payment-intent is a documented no-op on a push intent; it is
  ;; kept so both payment methods confirm through the same set of actions.
  {:name :transition/confirm-push-payment,
   :from :state/pending-confirmation,
   :to :state/paid,
   :actor :actor.role/operator,
   :actions
   [{:name :action/stripe-confirm-payment-intent}
    {:name :action/stripe-capture-payment-intent}
    {:name :action/stripe-create-payout}]}

  ;; The customer doesn't agree with the request.
  {:name :transition/decline,
   :from :state/payment-requested,
   :to :state/declined,
   :actor :actor.role/customer,
   :actions []}

  ;; The technician takes the request back.
  {:name :transition/withdraw,
   :from :state/payment-requested,
   :to :state/declined,
   :actor :actor.role/provider,
   :actions []}

  {:name :transition/operator-decline,
   :from :state/payment-requested,
   :to :state/declined,
   :actor :actor.role/operator,
   :actions []}

  ;; A request that is never answered stops being payable after a week.
  {:name :transition/expire,
   :from :state/payment-requested,
   :to :state/expired,
   :at
   {:fn/plus
    [{:fn/timepoint [:time/first-entered-state :state/payment-requested]}
     {:fn/period ["P7D"]}]},
   :actions []}

  ;; The customer opened the modal but never confirmed the card. Nothing was
  ;; captured - this only drops an authorization.
  {:name :transition/expire-payment,
   :from :state/pending-confirmation,
   :to :state/expired,
   :at
   {:fn/plus
    [{:fn/timepoint [:time/first-entered-state :state/pending-confirmation]}
     {:fn/period ["P7D"]}]},
   :actions []}],

 :notifications
 [{:name :notification/extra-payment-requested,
   :on :transition/request-extra-payment,
   :to :actor.role/customer,
   :template :extra-payment-requested}
  {:name :notification/extra-payment-paid,
   :on :transition/confirm-payment,
   :to :actor.role/provider,
   :template :extra-payment-paid}
  {:name :notification/extra-payment-declined,
   :on :transition/decline,
   :to :actor.role/provider,
   :template :extra-payment-declined}
  {:name :notification/extra-payment-paid-push,
   :on :transition/confirm-push-payment,
   :to :actor.role/provider,
   :template :extra-payment-paid}]}
